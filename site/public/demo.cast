u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b(B\u001b[m"]
[51.1732, "o", "\u001b[32m\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u001b[39m\u001b[24D\u001b[K\u001b[32m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[90m\u2591\u2591\u2591\u001b[39m\u00