# Copy to roaming.env and fill in your deployment, then run ./run.sh
#
# Nothing here changes how tingly-shell is deployed: the harness starts a
# normal tunnel client on a local port, which is one of the two supported
# usage forms.

# Where the tunnel server runs, and what it is allowed to dial.
TINGLY_SERVER=tunnel.example.com:7443
TINGLY_TARGET=127.0.0.1:22

# Credentials. The pin is public, the token is the secret: see
# docs/04-security-model.md §2.1.
TINGLY_TOKEN_FILE=$HOME/.tingly/token
TINGLY_PIN=sha256:REPLACE_ME

# The account to log in as on the far side.
SSH_USER=me

# Extra lines spliced into the harness ssh_config, e.g. a key to use.
#SSH_EXTRA_CONFIG="    IdentityFile $HOME/.ssh/id_ed25519"

# Binary under test.
#TINGLY_BIN=/usr/local/bin/tingly-shell

# Network control: auto, nmcli, macos, manual. auto picks nmcli or macos when
# available and falls back to manual prompts.
#NET_CTL=auto
#WIFI_IFACE=en0

# Timings and thresholds.
#LINGER=60                 # --session-linger, and what R4 waits past
#OUTAGE_SECONDS=40         # R3, must stay below LINGER
#MAX_STALL=20              # acceptable terminal freeze on a path change
#OBSERVE_SECONDS=25
#IDLE_SECONDS=600          # R5, NAT idle test
#BULK_MB=64                # R6

# Optional, enables R7: how to restart the tunnel server.
#SERVER_RESTART_CMD="ssh tunnel.example.com sudo systemctl restart tingly-shell"
